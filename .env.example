# Nusxa oling: .env — va qiymatlarni to'ldiring. .env git'ga qo'shilmaydi.

APP_DEBUG=false
APP_TIMEZONE=Asia/Tashkent
# public/ papkasiga qaraydigan HTTPS manzil (oxirida / siz)
APP_URL=https://example.uz

DB_HOST=localhost
DB_PORT=3306
DB_NAME=lionlavash
DB_USER=lionlavash
DB_PASS=

# @BotFather dan olingan token
CUSTOMER_BOT_TOKEN=
# Tasodifiy satr: 1-256 belgi, faqat A-Z a-z 0-9 _ -
CUSTOMER_WEBHOOK_SECRET=

# Yangi buyurtma va cheklar yuboriladigan chat (shaxsiy chat ID yoki guruh ID, masalan -100...)
ADMIN_CHAT_ID=
